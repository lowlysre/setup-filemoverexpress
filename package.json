{
  "name": "setup-filemoverexpress",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action to install and configure the AWS File Mover Express CLI",
  "license": "Apache-2.0",
  "author": "lowlysre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lowlysre/setup-filemoverexpress.git"
  },
  "keywords": [
    "actions",
    "aws",
    "s3",
    "filemoverexpress",
    "setup"
  ],
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write . \"!dist/**\" \"!package-lock.json\"",
    "format:check": "prettier --check . \"!dist/**\" \"!package-lock.json\"",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "all": "npm run format && npm run lint && npm run typecheck && npm test && npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "endOfLine": "lf"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
